#!/usr/bin/env sh
# Auto-tags release commits on the default branch.
#
# catalyst-requires: versioning
#   Needs the project to version ITSELF (its own VERSION file) — not the
#   Catalyst version stamp, which every project carries regardless. The
#   scaffolder and upgrader only offer this hook where that file exists.
#
# Optional — never installed automatically (agents don't install or configure hooks; see prime-directive.md Document Validation). To enable in a clone:
#   sh tools/hooks/install.sh post-commit
#
# When a commit on the default branch (`master` in a fresh spawn; resolution: README.md here) changes VERSION, tags that commit `v<VERSION>` (skipped if the tag already exists). Local tag only — push it yourself with `git push --tags` when ready to publish the release.

set -eu

# Default branch: explicit override, then the remote's HEAD, then whichever of master/main exists.
default=$(git config --get catalyst.defaultbranch) ||
    default=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) ||
    default=
default=${default#origin/}
if [ -z "$default" ]; then
    if git rev-parse -q --verify refs/heads/master >/dev/null 2>&1; then
        default=master
    elif git rev-parse -q --verify refs/heads/main >/dev/null 2>&1; then
        default=main
    else
        exit 0
    fi
fi

branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" = "$default" ] || exit 0

git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -qx VERSION || exit 0

tag="v$(cat VERSION)"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1; then
    echo "tools/hooks/post-commit: tag $tag already exists, skipping" >&2
    exit 0
fi

git tag "$tag"
echo "tools/hooks/post-commit: tagged $tag"
