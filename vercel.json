{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "images": {
    "sizes": [
      24, 48, 52, 90, 104, 108, 120, 180, 216, 224, 240, 256, 448, 512, 2560
    ],
    "formats": ["image/webp", "image/avif"],
    "minimumCacheTTL": 31536000
  },
  "services": {
    "web": {
      "root": ".",
      "framework": "nuxtjs"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.asgi:app",
      "installCommand": "uv sync --locked"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/healthz", "destination": { "service": "api" } },
    { "source": "/readyz", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
