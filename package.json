{
  "name": "z-team-planner",
  "version": "v0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "game-data:export": "node scripts/export-game-data.ts",
    "lint": "oxlint && node scripts/check-sfc-size.ts",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.134",
    "@nuxt/image": "2.1.0",
    "@nuxt/test-utils": "3.23.0",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/seo": "5.3.16",
    "@pinia/colada": "^1.4.5",
    "@pinia/colada-nuxt": "^1.2.0",
    "@pinia/nuxt": "^1.0.2",
    "@regle/core": "^1.29.1",
    "@regle/nuxt": "^1.29.1",
    "@regle/rules": "^1.29.1",
    "firebase": "^12.19.0",
    "nuxt": "^4.3.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.5.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5"
}
