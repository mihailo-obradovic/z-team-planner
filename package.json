{
  "name": "z-team-planner",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "game-data:export": "node scripts/export-game-data.ts",
    "lint": "oxlint && node scripts/check-sfc-size.ts",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@nuxt/image": "2.1.0",
    "@nuxt/test-utils": "4.3.3",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/seo": "5.3.16",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/nuxt": "^1.0.2",
    "@regle/core": "^1.29.4",
    "@regle/nuxt": "^1.29.4",
    "@regle/rules": "^1.29.4",
    "firebase": "^12.18.0",
    "nuxt": "^4.6.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@unhead/vue": "^3.4.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
