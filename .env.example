# * Copy to .env and fill in. .env is gitignored; this file is the committed template.

APP_ENV=development
SERVICE_NAME=api
LOG_LEVEL=INFO

# * Pooled Neon endpoint — the API's traffic.  neon connection-string dev --pooled
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# ! Direct endpoint, migrations only. Alembic must never see the pooled URL — it is PgBouncer in transaction mode, where session-level advisory locks fail silently.  neon connection-string dev
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# * Deny-by-default: leave empty to allow no browser origin at all.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# * The Firebase project every accepted ID token must be minted for — the issuer and audience checks derive from it.
FIREBASE_PROJECT_ID=z-team-planner
# ! Never in the repository: this file lives outside it, 0700. Required unless the emulator host below is set.
FIREBASE_SERVICE_ACCOUNT_FILE=/home/you/.z-team-planner/firebase-service-account.json

MAX_REQUEST_BYTES=65536
METRICS_ENABLED=false

# ! Development only. Set outside development, the API refuses to start: emulator tokens are unsigned, so it would be a total auth bypass.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# * Frontend (Nuxt reads this file too). Required at build time — the build fails without them.
# * The four Firebase values are public; they ship in the browser bundle and are not secrets.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NUXT_PUBLIC_FIREBASE_API_KEY=AIza-example
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=example
NUXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# * Development only: point the web SDK at the local Auth emulator. Leave unset otherwise.
# NUXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
