{
  "name": "z-team-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "game-data:export": "node scripts/export-game-data.ts",
    "lint": "oxlint && node scripts/check-sfc-size.ts",
    "check:budget": "node scripts/check-bundle-budget.ts",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@nuxt/image": "2.2.1",
    "@nuxt/test-utils": "4.3.4",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/seo": "5.3.16",
    "@pinia/colada": "^1.4.9",
    "@pinia/colada-nuxt": "^1.2.1",
    "@pinia/nuxt": "^1.0.3",
    "@regle/core": "^1.29.5",
    "@regle/rules": "^1.29.5",
    "firebase": "^12.19.0",
    "nuxt": "^4.6.3",
    "nuxt-security": "2.7.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@unhead/vue": "^3.4.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
