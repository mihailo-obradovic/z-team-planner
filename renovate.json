{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>nuxt/renovate-config-nuxt"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "automerge": false,
  "packageRules": [
    {
      "description": "TypeScript 7 drops the JS compiler API vue-tsc builds on; hold until vue-tsc supports it (decision 016).",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
